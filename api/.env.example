# 应用配置
APP_NAME=Soccer Data API
APP_VERSION=1.0.0
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置（根据实际情况修改）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=soccer
DB_PASSWORD=123456
DB_NAME=soccer_data

# JWT 认证配置（生产环境请修改为强密钥）
SECRET_KEY=your-secret-key-change-in-production-abcdefghijklmnopqrstuvwxyz123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 配置
ALLOWED_ORIGINS=["*"]
